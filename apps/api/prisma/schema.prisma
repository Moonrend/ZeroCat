// 用户账户令牌表
// 统一令牌表 (会话 / 个人API / OAuth 三类令牌的唯一来源)
// 所有令牌均为不透明随机串，仅存储 SHA-256 哈希；scope 用于精细化鉴权
model ow_tokens {
  id                 Int       @id @default(autoincrement())
  user_id            Int?
  // 令牌类型: session(登录会话) | personal(个人API令牌) | oauth(第三方授权)
  type               String    @default("session") @db.VarChar(20)
  name               String?   @db.VarChar(255)
  // 访问令牌哈希 (SHA-256 hex), 不存明文
  token_hash         String    @unique @db.VarChar(64)
  // 展示用前缀 (如 zc_a1b2c3..)
  token_prefix       String?   @db.VarChar(32)
  // 刷新令牌哈希 (会话/oauth 适用)
  refresh_token_hash String?   @unique @db.VarChar(64)
  // 授予的 scope 列表, 如 ["*"] 或 ["project:read","project:118:write"]
  scopes             Json
  // OAuth 关联 (type=oauth 时填写)
  application_id     Int?
  authorization_id   Int?
  expires_at         DateTime? @db.Timestamp(6)
  refresh_expires_at DateTime? @db.Timestamp(6)
  last_used_at       DateTime? @db.Timestamp(6)
  last_used_ip       String?   @db.VarChar(100)
  activity_count     Int       @default(0)
  ip_address         String?   @db.VarChar(100)
  user_agent         String?
  device_info        String?
  revoked            Boolean   @default(false)
  revoked_at         DateTime? @db.Timestamp(6)
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @updatedAt @db.Timestamp(6)

  // 关联
  user          ow_users?                @relation("UserTokens", fields: [user_id], references: [id], onDelete: SetNull, onUpdate: SetNull)
  application   ow_oauth_applications?   @relation(fields: [application_id], references: [id], onDelete: SetNull, onUpdate: SetNull)
  authorization ow_oauth_authorizations? @relation(fields: [authorization_id], references: [id], onDelete: SetNull, onUpdate: SetNull)

  @@index([token_hash])
  @@index([refresh_token_hash])
  @@index([user_id])
  @@index([type])
  @@index([application_id])
  @@index([authorization_id])
  @@index([expires_at])
  @@map("ow_tokens")
}

