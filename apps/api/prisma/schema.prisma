generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  relationMode = "prisma"

}

// 评论表
model ow_comment {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  type       String?   @default("comment") @db.VarChar(64)
  text       String?
  insertedAt DateTime? @default(now()) @db.Timestamp(6)
  user_ip    String?   @default("") @db.VarChar(100)
  link       String?   @db.VarChar(128)
  pid        Int?
  rid        Int?
  status     String    @default("") @db.VarChar(50)
  user_ua    String?
  url        String?   @db.VarChar(255)
  page_type  String?   @db.VarChar(32)
  page_id    String?   @db.VarChar(32)
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @db.Timestamp(6)
  page_key   String?   @db.VarChar(128)

  // 关联
  user ow_users? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: SetNull)

  @@index([page_type, page_id, insertedAt])
  @@index([user_id])
  @@map("ow_comment")
}

// 项目表
model ow_projects {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(128)
  default_branch String?   @db.VarChar(128)
  type           String?   @default("text") @db.VarChar(32)
  license        String?   @db.VarChar(32)
  authorid       Int?
  thumbnail      String    @default("") @db.VarChar(37)
  state          String    @default("private") @db.VarChar(32)
  view_count     Int       @default(0)
  like_count     Int       @default(0)
  favo_count     Int       @default(0)
  time           DateTime  @default(now()) @db.Timestamp(6)
  title          String    @default("ZeroCat新项目") @db.VarChar(1000)
  description    String    @default("ZeroCat上的项目") @db.Text
  history        Boolean   @default(true)
  fork           Int?
  star_count     Int       @default(0)
  deleted_at     DateTime? @db.Timestamp(6)
  deleted_by     Int?
  deletion_source String?  @db.VarChar(32)
  deletion_reason String?  @db.VarChar(1000)
  is_shadowbanned Boolean  @default(false)
  shadowban_expires_at DateTime? @db.Timestamp(6)
  shadowban_by   Int?
  shadowban_reason String? @db.VarChar(1000)

  // 关联
  author            ow_users?                   @relation("ProjectAuthor", fields: [authorid], references: [id], onDelete: SetNull, onUpdate: SetNull)
  stars             ow_projects_stars[]
  lists             ow_projects_list_items[]
  branches          ow_projects_branch[]
  project_tags      ow_projects_tags[]
  extensions        ow_scratch_extensions[]     @relation("ProjectExtensions")
  sample_extensions ow_scratch_extensions[]     @relation("SampleProject")
  assets            ow_projects_assets[]        @relation("ProjectAssets")
  collaboration_invitations ow_project_collaboration_invitations[] @relation("ProjectCollaborationInvitations")

  @@index([state])
  @@index([deleted_at, state, time(sort: Desc)])
  @@index([authorid, deleted_at])
  @@index([is_shadowbanned, shadowban_expires_at])
  @@index([authorid])
  @@index([time(sort: Desc)])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_ow_projects_name_trgm")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_ow_projects_title_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_ow_projects_description_trgm")
  @@map("ow_projects")
}

// 用户表
model ow_users {
  id               Int       @id @default(autoincrement())
  username         String    @unique @db.VarChar(64)
  email            String?   @db.VarChar(100)
  password         String?   @db.VarChar(255)
  display_name     String    @default("ZeroCat创作者") @db.VarChar(64)
  status           String    @default("active") @db.VarChar(20)

  // 个人资料信息
  motto            String?
  bio              String?
  location         String?   @db.VarChar(100)
  region           String?   @db.VarChar(100)
  birthday         DateTime? @default("2000-03-31T00:00:00.000Z") @db.Timestamp(6)
  sex              String    @default("0") @db.VarChar(16)
  url              String?   @db.VarChar(512)
  custom_status    Json?
  featured_projects Int?

  // 视觉元素
  images  String @default("870582712ab041107f1571285bc95a83") @db.VarChar(512)
  avatar  String @default("870582712ab041107f1571285bc95a83") @db.VarChar(512)

  // 系统字段
  type      String    @default("guest") @db.VarChar(50)
  label     String?   @db.VarChar(255)
  loginTime DateTime? @default(now()) @db.Timestamp(6)
  regTime   DateTime? @default(now()) @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)
  embedding_at DateTime? @db.Timestamp(6) // 最近一次向量生成时间

  // 关联
  authored_projects       ow_projects[]           @relation("ProjectAuthor")
  starred_projects        ow_projects_stars[]
  project_lists           ow_projects_lists[]
  contacts                ow_users_contacts[]
  relationships_as_source ow_user_relationships[] @relation("RelationshipSource")
  relationships_as_target ow_user_relationships[] @relation("RelationshipTarget")
  notifications_acted     ow_notifications[]      @relation("NotificationActor")
  events_acted            ow_events[]             @relation("EventActor")
  comments                ow_comment[]
  commits                 ow_projects_commits[]
  oauth_applications      ow_oauth_applications[]
  oauth_authorizations    ow_oauth_authorizations[]
  oauth_access_tokens     ow_oauth_access_tokens[]
  kv_store                ow_cache_kv[]
  tokens                  ow_tokens[]             @relation("UserTokens")
  uploaded_assets         ow_assets[]             @relation("AssetUploader")
  banned_assets           ow_assets[]             @relation("AssetBannedBy")
  push_subscriptions      ow_push_subscriptions[] @relation("UserPushSubscriptions")
  posts                   ow_posts[]              @relation("PostAuthor")
  likes                   ow_posts_like[]         @relation("LikeAuthor")
  bookmarks               ow_posts_bookmark[]     @relation("BookmarkAuthor")
  mentioned_in_posts      ow_posts_mention[]      @relation("UserMentions")
  comment_spaces          ow_comment_spaces[]     @relation("CommentSpaceOwner")
  comment_service_users   ow_comment_service_users[] @relation("CommentServiceUser")
  embedding_updates       ow_user_embedding_updates[]
  notification_settings ow_notification_settings[]
  restrictions            ow_user_restrictions[] @relation("UserRestrictions")
  direct_permissions      ow_user_permissions[]  @relation("UserDirectPermissions")
  delegations_sent        ow_permission_delegations[] @relation("DelegationGrantor")
  delegations_received    ow_permission_delegations[] @relation("DelegationDelegate")
  linked_service_comments ow_comment_service[] @relation("CommentAccountUser")
  role_assignments        ow_user_roles[]         @relation("UserRoleAssignments")
  assigned_role_records   ow_user_roles[]         @relation("UserRoleAssignedBy")
  sent_project_collaboration_invitations ow_project_collaboration_invitations[] @relation("ProjectCollaborationInviter")
  received_project_collaboration_invitations ow_project_collaboration_invitations[] @relation("ProjectCollaborationInvitee")

  @@index([email])
  @@index([status])
  @@index([embedding_at])
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_ow_users_username_trgm")
  @@index([display_name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_ow_users_display_name_trgm")
  @@index([bio(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_ow_users_bio_trgm")
  @@index([motto(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_ow_users_motto_trgm")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_ow_users_location_trgm")
  @@index([region(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_ow_users_region_trgm")
  @@map("ow_users")
}

// 角色表
model ow_roles {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?
  system      Boolean  @default(false)
  priority    Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  permissions ow_role_permissions[] @relation("RolePermissions")
  users       ow_user_roles[]        @relation("RoleAssignments")
  parents     ow_role_inheritance[]  @relation("InheritedRole")
  children    ow_role_inheritance[]  @relation("ParentRole")

  @@index([system])
  @@index([priority])
  @@map("ow_roles")
}

// 角色权限策略表
model ow_role_permissions {
  id         Int      @id @default(autoincrement())
  role_id    Int
  scope      String   @db.VarChar(160)
  effect     String   @default("allow") @db.VarChar(16)
  conditions Json?
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  role ow_roles @relation("RolePermissions", fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([role_id, scope, effect])
  @@index([scope])
  @@index([effect])
  @@map("ow_role_permissions")
}

// 用户角色分配表
model ow_user_roles {
  id          Int       @id @default(autoincrement())
  user_id     Int
  role_id     Int
  assigned_by Int?
  reason      String?   @db.VarChar(255)
  expires_at  DateTime? @db.Timestamp(6)
  grant_type  String    @default("manual") @db.VarChar(64)
  target_type String    @default("global") @db.VarChar(64)
  target_id   String    @default("global") @db.VarChar(64)
  metadata    Json?
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  user             ow_users  @relation("UserRoleAssignments", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role             ow_roles  @relation("RoleAssignments", fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assigned_by_user ow_users? @relation("UserRoleAssignedBy", fields: [assigned_by], references: [id], onDelete: SetNull, onUpdate: SetNull)

  @@unique([user_id, role_id, target_type, target_id])
  @@index([user_id])
  @@index([role_id])
  @@index([assigned_by])
  @@index([expires_at])
  @@index([grant_type])
  @@index([target_type, target_id])
  @@map("ow_user_roles")
}

// 子角色继承父角色的权限，写入服务以串行事务检查有向无环关系。
model ow_role_inheritance {
  role_id        Int
  parent_role_id Int
  created_at     DateTime @default(now()) @db.Timestamp(6)
  role           ow_roles @relation("InheritedRole", fields: [role_id], references: [id], onDelete: Cascade)
  parent_role    ow_roles @relation("ParentRole", fields: [parent_role_id], references: [id], onDelete: Cascade)

  @@id([role_id, parent_role_id])
  @@index([parent_role_id])
}

model ow_user_permissions {
  id          Int @id @default(autoincrement())
  user_id     Int
  scope       String @db.VarChar(160)
  effect      String @default("allow") @db.VarChar(16)
  target_type String @default("global") @db.VarChar(64)
  target_id   String @default("global") @db.VarChar(64)
  assigned_by Int?
  reason      String? @db.VarChar(1000)
  expires_at  DateTime? @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user        ow_users @relation("UserDirectPermissions", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, scope, effect, target_type, target_id])
  @@index([user_id, target_type, target_id])
  @@index([expires_at])
  @@index([assigned_by])
}

model ow_permission_delegations {
  id          Int @id @default(autoincrement())
  grantor_id  Int
  delegate_id Int
  target_type String @db.VarChar(64)
  target_id   String @db.VarChar(64)
  scopes      Json
  status      String @default("pending") @db.VarChar(16)
  reason      String? @db.VarChar(1000)
  expires_at  DateTime? @db.Timestamp(6)
  accepted_at DateTime? @db.Timestamp(6)
  revoked_at  DateTime? @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)
  grantor     ow_users @relation("DelegationGrantor", fields: [grantor_id], references: [id], onDelete: Cascade)
  delegate    ow_users @relation("DelegationDelegate", fields: [delegate_id], references: [id], onDelete: Cascade)

  @@index([grantor_id, status])
  @@index([delegate_id, status])
  @@index([target_type, target_id])
  @@index([expires_at])
}

model ow_user_restrictions {
  id          Int @id @default(autoincrement())
  user_id     Int
  type        String @db.VarChar(16)
  categories  String[] @default(["*"])
  reason      String? @db.VarChar(1000)
  starts_at   DateTime @default(now()) @db.Timestamp(6)
  expires_at  DateTime? @db.Timestamp(6)
  created_by  Int?
  revoked_at  DateTime? @db.Timestamp(6)
  revoked_by  Int?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  user        ow_users @relation("UserRestrictions", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, type, revoked_at, expires_at])
  @@index([type, starts_at, expires_at])
  @@index([created_by])
  @@index([revoked_by])
}

// 项目合作者邀请表
model ow_project_collaboration_invitations {
  id          Int       @id @default(autoincrement())
  project_id  Int
  inviter_id  Int
  invitee_id  Int
  role_key    String    @db.VarChar(64)
  status      String    @default("pending") @db.VarChar(32)
  message     String?   @db.VarChar(500)
  responded_at DateTime? @db.Timestamp(6)
  expires_at  DateTime? @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  project ow_projects @relation("ProjectCollaborationInvitations", fields: [project_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inviter ow_users @relation("ProjectCollaborationInviter", fields: [inviter_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitee ow_users @relation("ProjectCollaborationInvitee", fields: [invitee_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([project_id, invitee_id, role_key, status], map: "ow_project_collaboration_invitations_project_id_invitee_id_role")
  @@index([project_id])
  @@index([inviter_id])
  @@index([invitee_id])
  @@index([status])
  @@index([expires_at])
  @@map("ow_project_collaboration_invitations")
}

model ow_user_embedding_updates {
  id                 BigInt   @id @default(autoincrement())
  user_id            Int
  trigger_type       String   @default("scheduled") @db.VarChar(32)
  algorithm          String   @default("interest_decay_v1") @db.VarChar(64)
  profile_text_hash  String?  @db.VarChar(64)
  interaction_hash   String?  @db.VarChar(64)
  interaction_count  Int      @default(0)
  base_weight        Float    @default(0)
  interaction_weight Float    @default(0)
  hot_score          Float    @default(0)
  decay_score        Float    @default(0)
  metadata           Json?
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @db.Timestamp(6)

  user ow_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id, created_at(sort: Desc)], map: "idx_ow_user_embedding_updates_user_created")
  @@index([trigger_type, created_at(sort: Desc)], map: "idx_ow_user_embedding_updates_trigger")
  @@map("ow_user_embedding_updates")
}

// 项目文件表
model ow_projects_file {
  sha256           String                  @id @db.VarChar(64)
  // Legacy inline body; new writes store only a private S3 pointer.
  source           String?
  storage_provider String?                 @db.VarChar(16)
  storage_bucket   String?                 @db.VarChar(255)
  storage_key      String?                 @db.Text
  content_size     BigInt?
  content_sha256   String?                 @db.VarChar(64)
  content_type     String?                 @db.VarChar(255)
  search_preview   String?                 @db.Text
  search_vector    Unsupported("tsvector")?
  create_time      DateTime?               @default(now()) @db.Timestamp(6)
  create_userid    Int?

  @@index([create_time], map: "idx_ow_projects_file_create_time")
  @@index([create_userid], map: "idx_ow_projects_file_create_userid")
  @@index([search_vector], type: Gin, map: "idx_ow_projects_file_search_vector")
  @@map("ow_projects_file")
}

// 项目历史表
model ow_projects_history {
  id          Int      @id @default(autoincrement())
  authorid    Int
  projectid   Int
  type        String?  @default("text") @db.VarChar(32)
  time        DateTime @default(now()) @db.Timestamp(6)
  title       String   @default("ZeroCat新项目") @db.VarChar(50)
  description String   @default("commit") @db.VarChar(1000)
  source      String?
  state       String   @default("private") @db.VarChar(32)
  licence     String?  @db.VarChar(45)
  tags        String?  @db.VarChar(100)

  @@index([projectid])
  @@index([authorid])
  @@map("ow_projects_history")
}

// 配置类型枚举
enum ow_config_type {
  STRING
  NUMBER
  BOOLEAN
  ARRAY
  ENUM
}

// 配置表
model ow_config {
  id         Int            @id @default(autoincrement())
  key        String         @unique @db.VarChar(255)
  value      String
  type       ow_config_type @default(STRING)
  metadata   Json?
  created_at DateTime       @default(now()) @db.Timestamp(6)
  updated_at DateTime       @default(now()) @db.Timestamp(6)

  @@map("ow_config")
}

// 用户TOTP表
model ow_users_totp {
  id                Int       @id @default(autoincrement())
  name              String    @default("验证器") @db.VarChar(128)
  user_id           Int
  type              String    @default("totp") @db.VarChar(45)
  status            String    @default("unverified") @db.VarChar(32)
  totp_secret       String?   @db.VarChar(255)
  totp_algorithm    String    @default("SHA256") @db.VarChar(10)
  totp_digits       Int       @default(6)
  totp_period       Int       @default(30)
  totp_last_updated DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)

  @@index([user_id])
  @@map("ow_users_totp")
}

// 项目标签表
model ow_projects_tags {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(45)
  projectid  Int?
  created_at DateTime @default(now()) @db.Timestamp(6)

  // 关联
  project ow_projects? @relation(fields: [projectid], references: [id], onDelete: SetNull, onUpdate: SetNull)

  @@index([projectid])
  @@index([name])
  @@map("ow_projects_tags")
}

// 项目收藏表
model ow_projects_stars {
  id         Int      @id @default(autoincrement())
  userid     Int?
  projectid  Int?
  createTime DateTime @default(now()) @db.Timestamp(6)

  // 关联
  user    ow_users?    @relation(fields: [userid], references: [id], onDelete: SetNull, onUpdate: SetNull)
  project ow_projects? @relation(fields: [projectid], references: [id], onDelete: SetNull, onUpdate: SetNull)

  @@unique([userid, projectid])
  @@index([projectid])
  @@index([userid])
  @@map("ow_projects_stars")
}

// 项目列表表
model ow_projects_lists {
  id          Int       @id @default(autoincrement())
  authorid    Int?
  title       String    @default("收藏夹") @db.VarChar(1024)
  description String    @default("列表") @db.VarChar(1024)
  state       String    @default("private") @db.VarChar(32)
  list        String?
  updateTime  DateTime? @db.Timestamp(6)
  createTime  DateTime  @default(now()) @db.Timestamp(6)

  // 关联
  author     ow_users?                @relation(fields: [authorid], references: [id], onDelete: SetNull, onUpdate: SetNull)
  list_items ow_projects_list_items[]

  @@index([authorid])
  @@map("ow_projects_lists")
}

// 项目提交表
model ow_projects_commits {
  id                 String   @id @db.VarChar(256)
  project_id         Int
  author_id          Int?
  branch             String   @default("main") @db.VarChar(255)
  parent_commit_id   String?  @db.VarChar(256)
  commit_message     String
  commit_date        DateTime @db.Timestamp(6)
  commit_file        String   @db.VarChar(256)
  commit_description String?
  depth              Int?

  // 关联
  parent_commit ow_projects_commits?  @relation("CommitTree", fields: [parent_commit_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  child_commits ow_projects_commits[] @relation("CommitTree")
  author        ow_users?             @relation(fields: [author_id], references: [id], onDelete: SetNull, onUpdate: SetNull)

  @@index([project_id, commit_date(sort: Desc)])
  @@index([parent_commit_id])
  @@index([author_id])
  @@map("ow_projects_commits")
}

// 魔法链接表
model ow_users_magiclink {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @db.Timestamp(6)

  @@index([expiresAt])
  @@map("ow_users_magiclink")
}

// 项目分支表
model ow_projects_branch {
  id                 Int         @id @default(autoincrement())
  name               String      @db.VarChar(128)
  latest_commit_hash String      @db.VarChar(64)
  description        String      @db.VarChar(128)
  projectid          Int?
  protected          Boolean     @default(false)
  creator            Int?

  // 关联
  project ow_projects? @relation(fields: [projectid], references: [id], onDelete: SetNull, onUpdate: SetNull)

  @@unique([projectid, name])
  @@index([creator])
  @@map("ow_projects_branch")
}



// 用户联系方式表
model ow_users_contacts {
  contact_id    Int                             @id @default(autoincrement())
  user_id       Int?
  contact_value String                          @unique @db.VarChar(255)
  contact_info  String?                         @db.VarChar(255)
  contact_type  String                          @db.VarChar(50)
  is_primary    Boolean                         @default(false)
  verified      Boolean                         @default(false)
  metadata      Json?
  created_at    DateTime                        @default(now()) @db.Timestamp(6)
  updated_at    DateTime                        @default(now()) @db.Timestamp(6)

  // 关联
  user ow_users? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: SetNull)

  @@index([user_id])
  @@index([user_id, contact_type])
  @@map("ow_users_contacts")
}

// 事件表
model ow_events {
  id          Int      @id @default(autoincrement())
  event_type  String   @db.VarChar(50)
  actor_id    Int?
  target_type String   @db.VarChar(50)
  target_id   Int
  event_data  Json
  created_at  DateTime @default(now()) @db.Timestamp(6)
  public      Boolean  @default(false)

  // 关联
  actor ow_users? @relation("EventActor", fields: [actor_id], references: [id], onDelete: SetNull, onUpdate: SetNull)

  @@index([created_at(sort: Desc)])
